rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net (Default-Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Core Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "hustenisama@gmail.com" || 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
      );
    }

    // General string and ID safety guards to prevent wallet depletion / payload injection
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if isSignedIn() || request.auth == null;
      allow create: if (isSignedIn() && isOwner(userId) && incoming().uid == userId && incoming().role in ["patient", "admin"]) || request.auth == null;
      allow update: if (isSignedIn() && (isOwner(userId) || isAdmin()) && (
        // Prevent self-assigned admin privilege escalation
        (incoming().role == existing().role || isAdmin()) &&
        // Immutability checks
        incoming().uid == existing().uid &&
        incoming().email == existing().email
      )) || (request.auth == null && incoming().diff(existing()).affectedKeys().hasOnly(["isPremium"]));
      allow delete: if isAdmin();
    }

    // --- Doctors Collection ---
    match /doctors/{doctorId} {
      allow read: if true; // Anyone can view the roster of medical professionals
      allow write: if isAdmin(); // Only admins can add or alter physicians
    }

    // --- Appointments Collection ---
    match /appointments/{appointmentId} {
      allow read, list: if request.auth == null || (isSignedIn() && (resource.data.patientId == request.auth.uid || isAdmin()));
      allow create: if request.auth == null || (isSignedIn() && incoming().patientId == request.auth.uid);
      allow update: if (isSignedIn() && (
        // Patients can ONLY cancel their appointments
        (existing().patientId == request.auth.uid && incoming().status == "cancelled" && incoming().diff(existing()).affectedKeys().hasOnly(["status"])) ||
        // Admins/doctors can confirm, complete, or update appointment details
        isAdmin()
      )) || (
        // Server can update paymentStatus and paymentReference
        request.auth == null && incoming().diff(existing()).affectedKeys().hasOnly(["paymentStatus", "paymentReference"])
      );
      allow delete: if isAdmin();
    }

    // --- Reports Collection ---
    match /reports/{reportId} {
      allow read, list: if request.auth == null || (isSignedIn() && (resource.data.patientId == request.auth.uid || isAdmin()));
      allow create: if request.auth == null || (isSignedIn() && incoming().patientId == request.auth.uid);
      allow update: if false; // Medical reports are immutable audits
      allow delete: if request.auth == null || (isSignedIn() && (resource.data.patientId == request.auth.uid || isAdmin()));
    }

    // --- Care Plans Collection ---
    match /care_plans/{planId} {
      allow read, list: if request.auth == null || (isSignedIn() && (resource.data.patientId == request.auth.uid || isAdmin()));
      allow create: if request.auth == null || (isSignedIn() && (incoming().patientId == request.auth.uid || isAdmin()));
      allow update, delete: if false; // AI care paths and diagnostics are immutable
    }

    // --- Payments Collection ---
    match /payments/{paymentId} {
      allow read, list: if request.auth == null || (isSignedIn() && (resource.data.patientId == request.auth.uid || isAdmin()));
      allow create: if request.auth == null || (isSignedIn() && (incoming().patientId == request.auth.uid || isAdmin()));
      allow update, delete: if false; // Immutable financial transaction logging
    }

    // --- Medical Histories Collection ---
    match /medical_histories/{patientId} {
      allow read: if request.auth == null || isOwner(patientId) || isAdmin();
      allow write: if request.auth == null || isOwner(patientId) || isAdmin();
    }

    // --- Medical Bills Collection ---
    match /medical_bills/{billId} {
      allow read, list: if request.auth == null || (isSignedIn() && (resource.data.patientId == request.auth.uid || isAdmin()));
      allow create, update: if request.auth == null || isAdmin();
      allow delete: if isAdmin();
    }

    // --- Medicine Purchases Collection ---
    match /medicine_purchases/{purchaseId} {
      allow read, list: if request.auth == null || (isSignedIn() && (resource.data.patientId == request.auth.uid || isAdmin()));
      allow create: if request.auth == null || (isSignedIn() && (incoming().patientId == request.auth.uid || isAdmin()));
      allow update, delete: if false;
    }

    // --- Medicines Collection ---
    match /medicines/{medicineId} {
      allow read: if true;
      allow write: if request.auth == null || isAdmin();
    }

    // --- System Settings Collection ---
    match /system_settings/{settingsId} {
      allow read: if true;
      allow write: if request.auth == null || isAdmin();
    }
  }
}
